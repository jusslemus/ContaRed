# Copiar valores reales a las variables de Coolify o a .env para Docker local.
# Este ejemplo no contiene credenciales reales.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=conta.red.com.sv,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://conta.red.com.sv
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_AUTH_REDIRECT_URL=https://conta.red.com.sv/?establecer-clave=1
VITE_API_BASE_URL=https://conta.red.com.sv
POSTGRES_HOST=your-pooler-host.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_SSLMODE=require
FRONTEND_PORT=8080
